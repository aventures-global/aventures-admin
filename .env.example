# Express API base URL (no trailing slash)
VITE_API_URL=http://localhost:3001

# Neon Auth endpoint (Managed Better Auth). Use the same URL as the customer client.
VITE_NEON_AUTH_URL=https://ep-xxxx.region.aws.neon.tech/neondb/auth

# Public site origin for "View live" links (defaults to http://localhost:5173 in dev)
VITE_PUBLIC_SITE_URL=http://localhost:5173
